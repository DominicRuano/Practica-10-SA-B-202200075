    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "AnalysisTemplate",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/tracking-id": "p9-platform:argoproj.io/AnalysisTemplate:sa-p9/catalogo-promotion"
        },
        "creationTimestamp": "2026-10-17T04:41:59Z",
        "generation": 2,
        "name": "catalogo-promotion",
        "namespace": "sa-p9",
        "resourceVersion": "1792217840575199017",
        "uid": "2f579079-a5a0-4c2f-8f52-72756c778cb3"
      },
      "spec": {
        "args": [
          {
            "name": "service"
          },
          {
            "name": "hash"
          }
        ],
        "metrics": [
          {
            "count": 3,
            "failureLimit": 1,
            "interval": "10s",
            "name": "candidate-traffic",
            "provider": {
              "prometheus": {
                "address": "http://p10-monitoring-prometheus.observabilidad.svc:9090",
                "query": "sum(increase(http_requests_total{service=\"{{args.service}}\",pod_template_hash=\"{{args.hash}}\"}[1m])) or vector(0)"
              }
            },
            "successCondition": "len(result) == 1 && result[0] >= 5"
          },
          {
            "count": 3,
            "failureLimit": 1,
            "interval": "10s",
            "name": "candidate-error-rate",
            "provider": {
              "prometheus": {
                "address": "http://p10-monitoring-prometheus.observabilidad.svc:9090",
                "query": "(sum(rate(http_requests_total{service=\"{{args.service}}\",pod_template_hash=\"{{args.hash}}\",status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{service=\"{{args.service}}\",pod_template_hash=\"{{args.hash}}\"}[1m])), 0.000001)"
              }
            },
            "successCondition": "len(result) == 1 && result[0] <= 0.01"
          },
          {
            "count": 3,
            "failureLimit": 1,
            "interval": "10s",
            "name": "candidate-p95",
            "provider": {
              "prometheus": {
                "address": "http://p10-monitoring-prometheus.observabilidad.svc:9090",
                "query": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"{{args.service}}\",pod_template_hash=\"{{args.hash}}\"}[1m])))"
              }
            },
            "successCondition": "len(result) == 1 && !isNaN(result[0]) && result[0] <= 0.5"
          }
        ]
      }
    },
